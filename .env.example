# ─────────────────────────────────────────────────────────────────────────────
# ตัวอย่างค่า environment ของ MJD Mobile Order — คัดลอกไปใช้จริง 2 แบบ
#
#   รันบนเครื่อง (pnpm dev)          : cp .env.example .env
#   รันด้วย docker compose           : cp .env.example .env.docker
#                                      docker compose --env-file .env.docker up -d
#
# ⚠️ ไฟล์นี้เป็นตัวอย่างเท่านั้น ห้ามใส่ค่าจริง/ความลับลงไปแล้ว commit
# ─────────────────────────────────────────────────────────────────────────────

# ───────────────── ฐานข้อมูล (docker compose ใช้ 3 ตัวนี้สร้าง DATABASE_URL ให้เอง) ────────────────
POSTGRES_USER=posmobileorderuser
POSTGRES_DB=posmobileorderdb
# ⚠️ ห้ามมีอักขระ / : @ # ? — connection string ถูกประกอบเป็น URL ตรง ๆ
# ถ้ามี @prisma/adapter-pg จะฟ้อง "Invalid URL" แล้วแอปต่อฐานไม่ได้ทั้งระบบ
# สร้างด้วย: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
POSTGRES_PASSWORD=change-me-base64url

# port ฝั่ง host (ในคอนเทนเนอร์ยังเป็น 5432 เสมอ)
# 5437 ถูก container posmobileorder-postgres ของ dev ยึดอยู่
DB_PORT=5438

# ── เฉพาะตอนรันบนเครื่องแบบไม่ใช้ compose ──
# compose ไม่ต้องตั้งค่านี้ (docker-compose.yml ประกอบ DATABASE_URL ให้แล้ว โดยชี้ host เป็น "db")
DATABASE_URL=postgresql://posmobileorderuser:change-me-base64url@localhost:5437/posmobileorderdb?schema=public

# ───────────────────────────────── แอป ────────────────────────────────
# port ฝั่ง host ของ service app (3000 = pos-app เดิม, 3001 = dev server)
APP_PORT=3002

# ต้องตรงกับ origin ที่เปิดใช้จริงเป๊ะ ๆ ไม่งั้น Better Auth ตอบ INVALID_ORIGIN ตอน sign-in
#   pnpm dev        → http://localhost:3001
#   docker compose  → http://localhost:3002
#   production      → https://posqr.jayjayservices.com
BETTER_AUTH_URL=http://localhost:3002

# ใช้เซ็น/เข้ารหัส session cookie — production ต้องเป็นคนละค่ากับ dev
# สร้างด้วย: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-random-32-bytes

# ──────────────────────────── อีเมล (Phase 5) ───────────────────────────
# เว้นว่างได้: dev จะพิมพ์ลิงก์ลง console ส่วน production จะ throw เมื่อมีการส่งอีเมล
RESEND_API_KEY=
# ต้องอยู่ใต้โดเมนที่ verify กับ Resend ไว้แล้ว
MAIL_FROM=MJD Mobile Order <no-reply@mail.jayjayservices.com>
MAIL_REPLY_TO=

# ───────────────── MJD Mobile Order: QR ฝั่งลูกค้า (Phase 9) ─────────────────
# URL ที่ฝังลงใน QR Code ของโต๊ะ — ต้องเป็นโดเมนที่ "มือถือลูกค้า" เปิดได้จริง
# ไม่ตั้ง = ใช้ BETTER_AUTH_URL แทน (localhost ใช้ไม่ได้กับมือถือที่สแกนจากกระดาษ)
#
# 🔥 บน production ตั้งให้ครบดีกว่าปล่อยว่าง — compose ยัดค่าว่างเข้าคอนเทนเนอร์เสมอ
#    โค้ดที่ใช้ `??` ล้วนจะไม่ fallback ให้ (?? มองว่า "" คือค่าที่ตั้งแล้ว) แล้ว QR จะได้
#    ค่าเป็น "/order/<token>" ซึ่งไม่ใช่ URL — มือถือที่สแกนจะเอาไปค้น Google แทนที่จะ
#    เปิดเว็บ (เจอจริงบน production) · lib/urls.ts กันไว้แล้วแต่อย่าพึ่งอย่างเดียว
APP_BASE_URL=https://posqr.jayjayservices.com

# ─────────────── MJD Mobile Order: เครื่องพิมพ์ครัว (Phase 8) ───────────────
# ESC/POS over TCP · เว้นว่าง = ไม่มีเครื่องพิมพ์ ระบบทำงานต่อได้ปกติ
KITCHEN_PRINTER_HOST=
KITCHEN_PRINTER_PORT=9100
KITCHEN_PRINTER_TIMEOUT_MS=4000

# ──────────────────── MJD Mobile Order: ชำระเงิน (Phase 10) ───────────────────
# (Phase 15a) เลขพร้อมเพย์รับเงินลูกค้า **เป็นของร้าน** — ตั้งที่ ตั้งค่าร้าน → การรับเงิน (StorePaymentConfig)
# env PROMPTPAY_ID เดิมเลิกใช้แล้ว ตั้งไว้ก็ไม่มีผล

# ──────────────────── ตรวจสลิปอัตโนมัติ (Phase 15b — โหมด ก+) ───────────────────
# ผู้ให้บริการตรวจสลิป: mock (dev/เทส ไม่ยิงเครือข่าย) | easyslip | slipok — ไม่ตั้ง = ร้านเลือกโหมด PROMPTPAY_SLIP ไม่ได้
# key เป็นของแพลตฟอร์ม โควตารวมทุกร้าน (ตัดสินใจ 2026-09-16) · SLIP_API_BRANCH_ID เฉพาะ SlipOK
# ⚠️ production ห้ามตั้ง mock — mock ไม่ตรวจอะไรจริง (มันปฏิเสธสลิปจริงทุกใบ แต่ payload MOCK|… ผ่านได้)
SLIP_PROVIDER=
SLIP_API_KEY=
SLIP_API_BRANCH_ID=
# สลิปที่โอนเก่ากว่านี้ (นาที) ไม่รับ — ค่าเริ่มต้น 30
SLIP_MAX_AGE_MINUTES=30

# ──────────────────── ค่าใช้งานแบบต่ออายุ (Phase 14b) ───────────────────
# พร้อมเพย์ของ "แพลตฟอร์ม" (เรา) ที่ร้านโอนค่าใช้งานเข้ามา — คนละตัวกับ PROMPTPAY_ID ซึ่งเป็นของร้านรับเงินลูกค้า
# เว้นว่าง = หน้า /billing ยังสร้างคำขอได้แต่ไม่มี QR ให้สแกน (บอกให้ติดต่อผู้ดูแล)
PLATFORM_PROMPTPAY_ID=
# secret ในเส้นทาง GET /api/cron/plan-expiry/<secret> ที่ ops/install-cron.sh ยิงวันละครั้งเพื่อส่งอีเมลเตือน 7/3/1 วัน
# ต้องยาว >= 16 ตัว: openssl rand -hex 24 · เว้นว่าง = route ตอบ 401 ตลอด (ไม่มีอีเมลเตือน แต่แบนเนอร์ในแอปยังขึ้น)
CRON_SECRET=

# ความลับที่ผู้ให้บริการต้องส่งมาใน header x-webhook-secret ของ POST /api/payments/webhook
# เว้นว่าง = ปิดเส้นทางยืนยันอัตโนมัติทั้งหมด (ตอบ 503) ไม่ใช่เปิดรับใครก็ได้
# สร้างด้วย: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
PAYMENT_WEBHOOK_SECRET=

# ──────────────── production: blue/green + แจ้งเตือน (Phase 5) ────────────────
# พอร์ตของแอปสองสี (ops/switch-deploy.sh สลับ nginx ระหว่างสองตัวนี้)
# ทั้งคู่ผูกกับ 127.0.0.1 เท่านั้น — nginx เป็นทางเดียวที่เข้าถึงได้จากภายนอก
APP_BLUE_PORT=3001
APP_GREEN_PORT=3002

# tag ของ image ที่รันอยู่ — ops/rollback.sh เขียนค่านี้เอง ปกติไม่ต้องตั้งมือ
APP_TAG=latest

# ปลายทางอีเมลแจ้งเตือนของสคริปต์ใน ops/ (backup ล้ม, health เปลี่ยนสถานะ, rollback ล้ม)
# ใช้ RESEND_API_KEY + MAIL_FROM ชุดเดียวกับแอป
#
# ⚠️ ต้องเป็นกล่องจดหมายที่ "รับอีเมลขาเข้าได้จริง" — โดเมนผู้ส่งของโปรเจกต์นี้ตั้งไว้ส่งออก
# อย่างเดียว (ไม่มี MX) ตั้งเป็น no-reply@ ของโดเมนตัวเองจะ hard-bounce ทุกฉบับ
# = service ล่มแล้วไม่มีใครรู้ · นี่คือผู้ "รับ" คนละตัวกับ MAIL_FROM ที่เป็นผู้ "ส่ง"
ALERT_EMAIL=

# ──────────── นโยบายการสมัครสมาชิกเอง (Phase 5 allowlist → Phase 14a เปิดสมัคร) ────────────
# ตั้งแต่ Phase 13 ผู้สมัครใหม่ไม่ได้อยู่ในร้านใคร — เห็นแค่ /no-store → /onboarding สร้างร้านของตัวเอง
# การเปิดสมัครจึงปลอดภัย (ไม่ได้เข้าหลังร้านของใคร) · ตรวจตามลำดับ:
#   1. SIGNUP_OPEN=true            → ใครก็สมัครได้ (โหมดแพลตฟอร์ม — ค่าที่ production ควรใช้ตั้งแต่ Phase 14a)
#   2. SIGNUP_ALLOWED_EMAILS/_DOMAINS → เฉพาะรายชื่อ (ใช้เมื่อ SIGNUP_OPEN ไม่ใช่ true)
#   3. ไม่ตั้งอะไรเลย = ปฏิเสธทุกคน (fail closed) — deploy โดยลืมตั้งจะไม่เปิดรับคนทั้งโลกโดยไม่รู้ตัว
SIGNUP_OPEN=
SIGNUP_ALLOWED_EMAILS=
# โดเมนต้องตรงทั้งตัว — ตั้ง example.com แล้ว sub.example.com หรือ evil-example.com ไม่ผ่าน
SIGNUP_ALLOWED_DOMAINS=

# ───────────────── SCB Open API (Phase 10) — ออก QR พร้อมเพย์แบบ Bill Payment ─────────────────
# ไม่ตั้ง = ระบบใช้ lib/promptpay.ts สร้าง QR เอง (ต้องให้พนักงานกดยืนยันการจ่ายด้วยมือ)
# sandbox: https://api-sandbox.partners.scb/partners/sandbox
SCB_API_BASE=
SCB_APP_NAME=
SCB_API_KEY=
SCB_API_SECRET=
# Biller ID ที่ SCB ออกให้ร้าน — ไม่ตั้ง = สร้าง QR ผ่านธนาคารไม่ได้
SCB_BILLER_ID=
# prefix ของ ref3 ที่ SCB กำหนดให้ร้าน (บังคับตามสเปก)
SCB_REF3_PREFIX=
# ความลับที่เป็น "ส่วนหนึ่งของ URL" ปลายทาง payment confirmation ของ SCB:
#   https://<โดเมน>/api/payments/webhook/scb/<ค่านี้>
# จำเป็นเพราะ SCB ไม่แนบ signature/credential ใด ๆ มากับ callback เลย
# สร้างด้วย: openssl rand -hex 32
SCB_WEBHOOK_SECRET=

# ──────────────────── SCB ต่อร้าน (Phase 15c — โหมด ข) ───────────────────
# กุญแจเข้ารหัส credential SCB ที่ร้านกรอกเองในหน้าตั้งค่าร้าน (AES-256-GCM) — 32 ไบต์ base64url:
#   openssl rand -base64 32 | tr +/ -_ | tr -d =
# ไม่ตั้ง = ฟอร์ม SCB ของร้านปิด (ร้าน default ยังใช้ SCB_* ข้างบนเป็น fallback ได้)
# ⚠️ เปลี่ยนกุญแจ = credential ที่เก็บไว้ทั้งหมดถอดไม่ออก ต้องให้ทุกร้านกรอกใหม่
PAYMENT_CONFIG_KEY=
