// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── คลังสินค้า (Phase 1) ─────────────────────────────

enum TransactionType {
  IN
  OUT
}

enum PaymentMethod {
  CASH
  TRANSFER
  QR
  /// ใหม่ใน Phase 10 — MJD Mobile Order เท่านั้น ยืนยันผ่าน webhook ของผู้ให้บริการ
  PROMPTPAY
  /// ใหม่ใน Phase 10 — EDC ที่เคาน์เตอร์ พนักงานกดยืนยันด้วยมือ (ไม่ใช่ payment gateway ในแอป)
  CARD
}

enum SaleStatus {
  COMPLETED
  VOIDED
}

model Product {
  id           String   @id @default(cuid())
  storeId      String
  sku          String
  name         String
  categoryId   String
  unit         String
  quantity     Int      @default(0)
  reorderPoint Int      @default(0)
  price        Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  store        Store              @relation(fields: [storeId], references: [id])
  category     Category           @relation(fields: [categoryId], references: [id])
  transactions StockTransaction[]
  saleItems    SaleItem[]

  @@unique([storeId, sku])
  @@index([storeId])
  @@index([name])
  @@index([categoryId])
  @@map("product")
}

/// ledger แบบ append-only — ห้ามลบ/แก้ย้อนหลัง ถ้าต้องกลับรายการให้สร้างรายการชดเชยใหม่
model StockTransaction {
  id        String          @id @default(cuid())
  storeId   String
  productId String
  type      TransactionType
  quantity  Int
  note      String?
  saleId    String?
  createdAt DateTime        @default(now())

  store   Store   @relation(fields: [storeId], references: [id])
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sale    Sale?   @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@index([productId])
  @@index([createdAt])
  @@index([saleId])
  @@map("stock_transaction")
}

// ───────────────────── Better Auth 1.7.x (โครงจาก @better-auth/core) ─────────────────────

/// สิทธิ์ย่อยที่เลือกได้อิสระเป็นชุดต่อ resource (§4)
enum PermissionAction {
  VIEW
  ADD
  EDIT
  DELETE
}

/// หน้า/โมดูลที่คุมสิทธิ์ได้ — ครอบ F1–F9 ตามตารางใน §4
/// หน้าของ MJD Mobile Order (F11–F22) ยังไม่อยู่ในชุดนี้ ใช้แค่ requireUser() ตามเดิม
enum ResourceKey {
  DASHBOARD
  PRODUCTS
  CATEGORIES
  STOCK_IN
  STOCK_OUT
  POS
  POS_HISTORY
  POS_CLOSING
  REPORTS
  USERS
  /// MJD Mobile Order (Phase 16) — ผังโต๊ะ/รายละเอียดโต๊ะ/ปิดบิล · KDS · การแจ้งเตือน · จัดการเมนู · จัดการโต๊ะ+QR
  MO_TABLES
  MO_KITCHEN
  MO_NOTIFICATIONS
  MO_MENU
  MO_SETUP
  /// Phase 17b — จอขายอาหารฝั่งพนักงาน (VIEW เข้าหน้า · ADD กดขาย/ส่งเข้าครัว)
  MO_POS
  /// Phase 20 (ร้านนวด) — ประวัติ/กะพนักงานนวด · ตารางจอง/เช็กอิน/กระดานว่าง-ไม่ว่าง
  SPA_THERAPISTS
  SPA_BOOKINGS
}

/// บทบาทเป็นของร้าน (Phase 13) — แต่ละร้านมีชุดของตัวเอง ร้านใหม่ได้ 3 บทบาทระบบตอนสร้าง
model Role {
  id          String   @id @default(cuid())
  storeId     String
  name        String
  description String?
  /// บทบาทระบบ — ห้ามแก้ชื่อและห้ามลบ (กันระบบเหลือคนจัดการสิทธิ์ 0 คน)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store       Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  members     StoreMember[]

  @@unique([storeId, name])
  @@index([storeId])
  @@map("role")
}

model RolePermission {
  id       String             @id @default(cuid())
  roleId   String
  resource ResourceKey
  /// ชุด action ที่บทบาทนี้ทำได้กับ resource นั้น — ว่าง = ไม่มีสิทธิ์เลย เมนูจะไม่แสดง
  actions  PermissionAction[]

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource])
  @@map("role_permission")
}

model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  emailVerified   Boolean  @default(false)
  image           String?
  /// ผู้ดูแลแพลตฟอร์ม (เรา) — คนละแกนกับ StoreMember.role และไม่ผูกกับร้านใด (Phase 13)
  isPlatformAdmin Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  storeMemberships          StoreMember[]
  ownedBrands               Brand[]           @relation("BrandOwner")
  sessions                  Session[]
  accounts                  Account[]
  sales                     Sale[]            @relation("SaleCashier")
  voided                    Sale[]            @relation("SaleVoidedBy")
  closedSessions            TableSession[]    @relation("SessionClosedBy")
  cancelledOrderItems       MobileOrderItem[] @relation("OrderItemCancelledBy")
  acknowledgedNotifications Notification[]    @relation("NotificationAckBy")
  storeSettingsUpdates      StoreSettings[]   @relation("StoreSettingsUpdatedBy")
  sentInvites               StoreInvite[]     @relation("StoreInviteInvitedBy")
  acceptedInvites           StoreInvite[]     @relation("StoreInviteAcceptedBy")
  uploadedAssets            StoreAsset[]      @relation("AssetUploadedBy")
  createdBookings           Booking[]         @relation("BookingCreatedBy")
  closings                  CashierClosing[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  issuer                String
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ───────────────────────────── POS หน้าร้าน (Phase 2.5) ─────────────────────────────

model Category {
  id        String   @id @default(cuid())
  storeId   String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store    Store     @relation(fields: [storeId], references: [id])
  products Product[]

  @@unique([storeId, name])
  @@index([storeId])
  @@map("category")
}

model Sale {
  id               String        @id @default(cuid())
  storeId          String
  /// เลขบิลเรียงต่อเนื่องภายในร้าน — unique ต่อร้าน (Phase 13) ทุกร้านเริ่ม INV-000001 ของตัวเอง
  saleNumber       String
  status           SaleStatus    @default(COMPLETED)
  subtotal         Decimal       @db.Decimal(12, 2)
  discount         Decimal       @default(0) @db.Decimal(12, 2)
  total            Decimal       @db.Decimal(12, 2)
  paymentMethod    PaymentMethod
  amountReceived   Decimal       @db.Decimal(12, 2)
  changeDue        Decimal       @default(0) @db.Decimal(12, 2)
  note             String?
  channel          SaleChannel   @default(RETAIL_POS)
  /// อ้างอิงการชำระเงินจากผู้ให้บริการ — unique เพื่อกัน webhook ที่ยิงซ้ำสร้างบิลซ้ำ (Phase 10)
  paymentReference String?       @unique
  tableSessionId   String?       @unique
  cashierId        String
  voidedAt         DateTime?
  voidedById       String?
  voidReason       String?
  createdAt        DateTime      @default(now())

  store         Store                   @relation(fields: [storeId], references: [id])
  cashier       User                    @relation("SaleCashier", fields: [cashierId], references: [id])
  session       TableSession?           @relation(fields: [tableSessionId], references: [id])
  pointTx       MemberPointTransaction?
  voidedBy      User?                   @relation("SaleVoidedBy", fields: [voidedById], references: [id])
  items         SaleItem[]
  transactions  StockTransaction[]
  /// ออร์เดอร์ครัวของบิลกลับบ้าน (Phase 17c) — บิลหน้าร้าน/บิลโต๊ะเป็น null
  takeawayOrder MobileOrder?

  @@unique([storeId, saleNumber])
  @@index([storeId])
  @@index([createdAt])
  @@index([cashierId])
  @@index([status])
  @@index([channel])
  @@map("sale")
}

model SaleItem {
  id          String  @id @default(cuid())
  saleId      String
  /// บิลขายหน้าร้านอ้าง Product — บิลจาก MJD Mobile Order เป็น null (อ้าง menuItemId แทน)
  productId   String?
  /// บิลจาก MJD Mobile Order อ้าง MenuItem — บิลขายหน้าร้านเป็น null
  menuItemId  String?
  /// พนักงานนวดที่ให้บริการบรรทัดนี้ (Phase 20) — snapshot ลงบิลไว้ทำรายงาน/ค่ามือต่อคน · บิลอาหาร/สินค้าเป็น null
  therapistId String?
  /// ชื่อรายการ ณ เวลาขาย (snapshot) — หน้าประวัติ/ใบเสร็จอ่านจากฟิลด์นี้ ไม่ต้อง join กลับ
  name        String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  subtotal    Decimal @db.Decimal(12, 2)

  sale      Sale       @relation(fields: [saleId], references: [id], onDelete: Cascade)
  // คง RESTRICT ไว้เหมือนก่อนทำให้ productId เป็น optional — ห้ามลบสินค้าที่เคยขายไปแล้ว
  // (ค่า default ของ Prisma สำหรับ relation แบบ optional คือ SetNull ซึ่งจะล้างประวัติการขายทิ้ง)
  product   Product?   @relation(fields: [productId], references: [id], onDelete: Restrict)
  menuItem  MenuItem?  @relation(fields: [menuItemId], references: [id])
  // RESTRICT — ห้ามลบพนักงานนวดที่มีชื่อในบิลแล้ว (ปิดใช้งานแทน) เหตุผลเดียวกับ product
  therapist Therapist? @relation(fields: [therapistId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
  @@index([menuItemId])
  @@map("sale_item")
}

/// บันทึกปิดยอดประจำวัน — immutable แก้/ลบผ่าน UI ไม่ได้
model CashierClosing {
  id            String   @id @default(cuid())
  storeId       String
  cashierId     String
  closingDate   DateTime @db.Date
  totalSales    Decimal  @db.Decimal(12, 2)
  totalCash     Decimal  @db.Decimal(12, 2)
  totalTransfer Decimal  @db.Decimal(12, 2)
  totalQR       Decimal  @db.Decimal(12, 2)
  /// รวมพร้อมเพย์/บัตร ที่ปิดบิลด้วยแคชเชียร์คนนี้ (Phase 10) — แยกจาก QR ไม่ให้ปนกับยอดสแกน QR หน้าร้าน
  totalCard     Decimal  @default(0) @db.Decimal(12, 2)
  billCount     Int      @default(0)
  voidedCount   Int      @default(0)
  countedCash   Decimal  @db.Decimal(12, 2)
  difference    Decimal  @db.Decimal(12, 2)
  note          String?
  closedAt      DateTime @default(now())

  store   Store @relation(fields: [storeId], references: [id])
  cashier User  @relation(fields: [cashierId], references: [id])

  @@unique([storeId, cashierId, closingDate])
  @@index([storeId])
  @@index([closingDate])
  @@map("cashier_closing")
}

// ───────────────────── MJD Mobile Order (Phase 6) ─────────────────────

enum SaleChannel {
  RETAIL_POS
  MOBILE_ORDER
  /// Phase 17c — พนักงานขายอาหารกลับบ้านหน้าเคาน์เตอร์ (ไม่มีโต๊ะ/ไม่มี TableSession)
  TAKEAWAY
}

enum TableStatus {
  EMPTY
  OPEN_NO_ORDER
  ORDERED
  AWAITING_BILL
  OCCUPIED_MERGED
}

enum TableSessionStatus {
  OPEN
  AWAITING_BILL
  CLOSED
  CANCELLED
}

enum OrderItemStatus {
  AWAITING_KITCHEN
  COOKING
  READY
  SERVED
  CANCELLED
}

enum QRCodeType {
  STATIC
  DYNAMIC
}

enum QRCodeStatus {
  ACTIVE
  INVALIDATED
}

enum NotificationType {
  CALL_STAFF
  CHECK_BILL
}

enum NotificationStatus {
  PENDING
  ACKNOWLEDGED
}

enum LineNotificationType {
  ORDER_CONFIRMED
  FOOD_READY
  PAYMENT_SUCCESS
}

enum ModifierSelectionType {
  SINGLE
  MULTIPLE
}

/// โต๊ะในร้าน — ชื่อตารางในฐานเป็น restaurant_table เพราะ table เป็นคำสงวนของ SQL
/// (เขียน raw SQL ทีไรต้องคอย quote ตลอด พลาดแล้ว tsc จับไม่ได้ ไปพังตอน runtime)
model Table {
  id             String      @id @default(cuid())
  storeId        String
  code           String
  /// denormalized — ต้องอัปเดตใน transaction เดียวกับเหตุการณ์เสมอ (เหมือน Product.quantity คู่กับ StockTransaction)
  status         TableStatus @default(EMPTY)
  /// Phase 20 — โต๊ะอาหาร หรือห้องนวด (จองล่วงหน้าได้เฉพาะ ROOM) · ร้านนวดมีทั้งสองแบบร่วมกันได้
  kind           TableKind   @default(TABLE)
  /// ประเภทห้อง (ห้องนวดเท้า/ห้องนวดไทย …) — ใช้ตาราง KitchenStation เดียวกับประเภทบริการของโปรแกรมนวด
  /// เพื่อให้ "ห้องต้องตรงกับรายการนวด" เช็คได้ · null = ห้องทั่วไป/โต๊ะ
  stationId      String?
  primaryTableId String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  store        Store           @relation(fields: [storeId], references: [id])
  primaryTable Table?          @relation("TableMerge", fields: [primaryTableId], references: [id])
  station      KitchenStation? @relation("RoomStation", fields: [stationId], references: [id], onDelete: SetNull)
  mergedTables Table[]         @relation("TableMerge")
  sessions     TableSession[]
  qrCodes      QRCode[]
  bookings     Booking[]

  @@unique([storeId, code])
  @@index([storeId])
  @@index([status])
  @@index([primaryTableId])
  @@index([stationId])
  @@map("restaurant_table")
}

/// ชนิดของ "โต๊ะ" (Phase 20) — TABLE = โต๊ะอาหาร · ROOM = ห้องนวด (จองล่วงหน้าได้ · มีประเภทห้อง)
enum TableKind {
  TABLE
  ROOM
}

model TableSession {
  id            String             @id @default(cuid())
  storeId       String
  tableId       String
  qrCodeId      String?
  openedAt      DateTime           @default(now())
  status        TableSessionStatus @default(OPEN)
  closedAt      DateTime?
  closedById    String?
  cancelReason  String?
  /// ชื่อลูกค้าของบิลนี้ (2026-09-23 · ร้านสปา) — ห้องนวดเดียวเปิดได้หลายบิลพร้อมกัน 1 บิลต่อลูกค้า
  /// ป้ายนี้ใช้แยกบิลบนผังห้อง/หน้าปิดบิล · null = บิลปกติของโต๊ะอาหาร หรือไม่ได้ระบุชื่อ
  customerLabel String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  store          Store                 @relation(fields: [storeId], references: [id])
  table          Table                 @relation(fields: [tableId], references: [id])
  qrCode         QRCode?               @relation(fields: [qrCodeId], references: [id])
  closedBy       User?                 @relation("SessionClosedBy", fields: [closedById], references: [id])
  orders         MobileOrder[]
  notifications  Notification[]
  lineLogs       LineNotificationLog[]
  /// คำขอชำระเงินที่เคยออก QR ให้โต๊ะนี้ — มีได้หลายใบ เพราะลูกค้ากดชำระเงินแล้วยกเลิก
  /// กลับไปสั่งเพิ่มได้ ยอดจึงเปลี่ยน ต้องออก QR ใบใหม่ ส่วนใบเก่าค้างเป็น PENDING แล้วหมดอายุไป
  paymentIntents PaymentIntent[]
  /// บิลที่เกิดตอนปิด session — FK อยู่ฝั่ง Sale (Sale.tableSessionId) ด้านเดียว
  /// ไม่เก็บ saleId ซ้ำที่นี่ เพราะ FK ชี้กันไปมาสองทางทำให้ลำดับการเขียนในทรานแซคชันพันกัน
  sale           Sale?
  /// การจองที่เช็กอินเข้ามาเป็น session นี้ (Phase 20b)
  bookings       Booking[]

  @@index([storeId])
  @@index([tableId])
  @@index([status])
  @@map("table_session")
}

model MenuItem {
  id                String       @id @default(cuid())
  storeId           String
  name              String
  description       String?
  price             Decimal      @db.Decimal(12, 2)
  imageUrl          String?
  isActive          Boolean      @default(true)
  /// ปักหมุดได้สูงสุด 6 รายการพร้อมกัน — บังคับที่ server action (F21)
  isFeatured        Boolean      @default(false)
  featuredSortOrder Int?
  /// Phase 20 — FOOD = อาหาร/เครื่องดื่ม (เข้าครัว/KDS) · SERVICE = โปรแกรมนวด (ต้องมีพนักงานนวด ไม่เข้า KDS)
  itemType          MenuItemType @default(FOOD)
  /// ระยะเวลาบริการเป็นนาที — บังคับเมื่อ itemType = SERVICE · ใช้คำนวณช่วงจอง/เวลาห้องไม่ว่าง
  durationMinutes   Int?
  /// ประเภทครัว/สถานีปรุงที่รับผิดชอบเมนูนี้ (Phase 19) — null = ไม่ระบุ · ลบ station แล้วเมนูกลับเป็น null ไม่หาย
  /// ในโหมดร้านนวด (Phase 20) ตารางเดียวกันนี้คือ "ประเภทบริการ" (นวดเท้า/นวดไทย …) ที่ผูกทั้งโปรแกรม ห้อง และทักษะพนักงาน
  stationId         String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  store          Store             @relation(fields: [storeId], references: [id])
  station        KitchenStation?   @relation(fields: [stationId], references: [id], onDelete: SetNull)
  modifierGroups ModifierGroup[]
  orderItems     MobileOrderItem[]
  saleItems      SaleItem[]
  bookings       Booking[]

  @@index([storeId])
  @@index([isActive])
  @@index([isFeatured])
  @@index([stationId])
  @@map("menu_item")
}

/// ชนิดของรายการในเมนู (Phase 20) — FOOD = อาหาร/เครื่องดื่ม (เข้าครัว/KDS) · SERVICE = โปรแกรมนวด (มีระยะเวลา ต้องมีพนักงานนวด)
enum MenuItemType {
  FOOD
  SERVICE
}

/// พนักงานนวด (Phase 20) — ไม่ผูกกับบัญชีล็อกอิน (พนักงานนวดไม่ต้องมี user) · `code` เช่น "001" unique ต่อร้าน
/// ทักษะ = ประเภทบริการ (KitchenStation) ที่ทำได้ · ปิดใช้งานด้วย isActive ไม่ลบ ถ้าเคยมีชื่อในบิล (SaleItem.therapistId RESTRICT)
model Therapist {
  id        String    @id @default(cuid())
  storeId   String
  code      String
  name      String
  nickname  String?
  phone     String?
  gender    String?
  startedAt DateTime? @db.Date
  note      String?
  imageUrl  String?
  isActive  Boolean   @default(true)
  /// ผูกกับบัญชีผู้ใช้ทีหลังได้ (ไม่บังคับ) — เผื่อให้พนักงานนวดล็อกอินดูคิวตัวเอง
  userId    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  store      Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  skills     KitchenStation[]  @relation("TherapistSkills")
  orderItems MobileOrderItem[]
  saleItems  SaleItem[]
  shifts     TherapistShift[]
  bookings   Booking[]

  @@unique([storeId, code])
  @@index([storeId])
  @@index([isActive])
  @@map("therapist")
}

/// กะทำงานของพนักงานนวด (Phase 20b) — 1 แถว = พนักงาน 1 คน ต่อ 1 วัน
///
/// เก็บ "รายวัน" ไม่ใช่รูปแบบประจำสัปดาห์ เพราะร้านนวดสลับกะ/ลาหยุดกันบ่อยจนรูปแบบประจำไม่เคยตรง —
/// การตั้งทั้งสัปดาห์ทำด้วยปุ่มคัดลอกในหน้าจอ (copyShifts) ซึ่งเขียนแถวรายวันให้ครบเหมือนกัน
/// · ไม่มีแถว = "ยังไม่ตั้งกะ" (ยังจองได้ แต่กระดานบอกว่ายังไม่เข้ากะ) · isOff = หยุด (จองไม่ได้)
model TherapistShift {
  id          String   @id @default(cuid())
  storeId     String
  therapistId String
  /// วันทำงานตามวันทางธุรกิจของร้าน (เวลาไทย) — ชนิด DATE ไม่มีเวลา
  workDate    DateTime @db.Date
  /// นาทีนับจากเที่ยงคืนของวันนั้น (08:30 = 510) — เก็บเป็นนาทีเพื่อเทียบช่วงได้ตรงโดยไม่ต้องยุ่งกับ timezone
  startMinute Int
  endMinute   Int
  /// วันหยุดของคนนี้ — เก็บแถวไว้เพื่อให้กระดานแยก "หยุด" ออกจาก "ยังไม่ตั้งกะ" ได้
  isOff       Boolean  @default(false)
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  therapist Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)

  @@unique([therapistId, workDate])
  @@index([storeId, workDate])
  @@map("therapist_shift")
}

/// สถานะการจอง (Phase 20b) — BOOKED → CHECKED_IN → IN_SERVICE → DONE คือเส้นทางปกติ
/// CANCELLED (ยกเลิก) และ NO_SHOW (ไม่มาตามนัด) เป็นทางออกที่ปล่อยช่วงเวลาคืนให้จองใหม่ได้
enum BookingStatus {
  BOOKED
  CHECKED_IN
  IN_SERVICE
  DONE
  CANCELLED
  NO_SHOW
}

/// การจองล่วงหน้า (Phase 20b)
///
/// **ไม่ใช่บิล** — เป็นแค่การกันเวลาของพนักงาน (และห้อง ถ้าเลือกไว้) · เงินเกิดตอนเช็กอินเท่านั้น
/// ซึ่งเปิด TableSession + MobileOrder ด้วยเส้นทางเดิม แล้วปิดบิลที่หน้าเดิมทุกประการ (กติกาข้อ 8)
/// · durationMinutes เป็น snapshot ณ ตอนจอง — แก้เวลาโปรแกรมในเมนูภายหลังต้องไม่ทำให้คิวที่จองไว้เลื่อน
/// · กันคิวชนกันด้วย advisory lock ต่อพนักงาน/ห้องใน lib/booking.ts (ไม่ใช่ EXCLUDE constraint เพราะ Prisma ไม่รู้จัก)
model Booking {
  id              String        @id @default(cuid())
  storeId         String
  customerName    String
  customerPhone   String?
  /// โปรแกรมนวดที่จอง (MenuItem.itemType = SERVICE)
  menuItemId      String
  /// snapshot ระยะเวลาจากเมนู ณ ตอนจอง
  durationMinutes Int
  /// พนักงานนวด — บังคับตั้งแต่ตอนจอง (ลูกค้ามักขอชื่อคนเดิม) · ห้องเลือกทีหลังตอนเช็กอินได้
  therapistId     String
  tableId         String?
  startAt         DateTime
  /// startAt + durationMinutes — เก็บซ้ำเพื่อให้ query ช่วงเวลาทับซ้อนทำได้ด้วย index เดียว
  endAt           DateTime
  status          BookingStatus @default(BOOKED)
  note            String?
  createdById     String?
  /// session ที่เกิดตอนเช็กอิน — ปิดบิลด้วยเส้นทางเดิมของโต๊ะ/ห้อง
  tableSessionId  String?
  checkedInAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  store     Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  menuItem  MenuItem      @relation(fields: [menuItemId], references: [id])
  therapist Therapist     @relation(fields: [therapistId], references: [id])
  table     Table?        @relation(fields: [tableId], references: [id], onDelete: SetNull)
  session   TableSession? @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)
  createdBy User?         @relation("BookingCreatedBy", fields: [createdById], references: [id])

  @@index([storeId, startAt])
  @@index([therapistId, startAt])
  @@index([tableId, startAt])
  @@index([status])
  @@map("booking")
}

/// ประเภทครัว / สถานีปรุง (Phase 19) — ของทอด ของผัด ต้ม/นึ่ง บาร์น้ำ ของหวาน ผลไม้ …
/// ใช้แยกจอ KDS ต่อครัว (`?station=`) และจัดกลุ่มบรรทัดบนทิกเก็ต (lib/ticket-lines.ts) · เป็นเรื่องหลังครัวล้วน
/// ลูกค้าไม่เห็น · เมนู 1 รายการอยู่ได้ครัวเดียว (MenuItem.stationId)
model KitchenStation {
  id        String   @id @default(cuid())
  storeId   String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store      Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  menuItems  MenuItem[]
  /// Phase 20 — ห้องนวดที่มีประเภทนี้ และพนักงานนวดที่มีทักษะนี้
  rooms      Table[]     @relation("RoomStation")
  therapists Therapist[] @relation("TherapistSkills")

  @@unique([storeId, name])
  @@index([storeId])
  @@map("kitchen_station")
}

model ModifierGroup {
  id            String                @id @default(cuid())
  storeId       String
  menuItemId    String
  name          String
  selectionType ModifierSelectionType @default(SINGLE)
  required      Boolean               @default(false)
  sortOrder     Int                   @default(0)

  store    Store            @relation(fields: [storeId], references: [id])
  menuItem MenuItem         @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  options  ModifierOption[]

  @@index([storeId])
  @@index([menuItemId])
  @@map("modifier_group")
}

model ModifierOption {
  id              String  @id @default(cuid())
  modifierGroupId String
  name            String
  priceDelta      Decimal @default(0) @db.Decimal(12, 2)
  sortOrder       Int     @default(0)

  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@index([modifierGroupId])
  @@map("modifier_option")
}

/// ประเภทออร์เดอร์ (Phase 17c) — กินที่ร้าน (ผูกโต๊ะ) หรือกลับบ้าน (ไม่มีโต๊ะ ผูกกับบิลที่จ่ายแล้ว)
enum MobileOrderType {
  DINE_IN
  TAKEAWAY
}

model MobileOrder {
  id             String          @id @default(cuid())
  storeId        String
  orderType      MobileOrderType @default(DINE_IN)
  /// null = ออร์เดอร์กลับบ้าน (ไม่มีโต๊ะ) — ก่อน Phase 17c ทุกแถวผูกโต๊ะเสมอ
  tableSessionId String?
  /// บิลของออร์เดอร์กลับบ้าน (จ่ายเงินตอนสั่ง) — ออร์เดอร์ที่โต๊ะเป็น null เพราะบิลออกตอนปิดโต๊ะ
  saleId         String?         @unique
  /// ชื่อ/เบอร์ 4 ตัวท้ายไว้เรียกลูกค้ามารับ — ใช้แทนเลขโต๊ะบนทิกเก็ตครัว
  customerLabel  String?
  /// เลขรอบสั่งภายใน session เดียวกัน (1, 2, 3, …) ใช้แยกทิกเก็ตครัว
  orderNumber    Int
  submittedAt    DateTime        @default(now())
  printedAt      DateTime?
  createdAt      DateTime        @default(now())

  store   Store             @relation(fields: [storeId], references: [id])
  session TableSession?     @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)
  /// บิลของออร์เดอร์กลับบ้าน — RESTRICT เพราะประวัติการขายต้องไม่ชี้ไปที่ว่าง (เหมือน SaleItem.product)
  sale    Sale?             @relation(fields: [saleId], references: [id], onDelete: Restrict)
  items   MobileOrderItem[]

  @@unique([tableSessionId, orderNumber])
  @@index([storeId])
  @@index([tableSessionId])
  @@map("mobile_order")
}

model MobileOrderItem {
  id                      String          @id @default(cuid())
  mobileOrderId           String
  menuItemId              String
  quantity                Int
  /// snapshot รวม modifier ณ เวลาสั่ง — เหมือน SaleItem.unitPrice กันแก้ราคาเมนูย้อนหลังแล้วบิลเก่าเพี้ยน
  unitPrice               Decimal         @db.Decimal(12, 2)
  /// [{ groupName, optionName, priceDelta }] — snapshot ด้วยเหตุผลเดียวกับ unitPrice
  selectedOptionsSnapshot Json            @default("[]")
  /// พนักงานนวดของบรรทัดบริการ (Phase 20) — ลูกค้าสั่งเองผ่าน QR จะเป็น null จนพนักงาน "มอบหมาย" · อาหารเป็น null เสมอ
  therapistId             String?
  note                    String?
  status                  OrderItemStatus @default(AWAITING_KITCHEN)
  cancelledAt             DateTime?
  cancelledById           String?
  cancelReason            String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  order       MobileOrder @relation(fields: [mobileOrderId], references: [id], onDelete: Cascade)
  menuItem    MenuItem    @relation(fields: [menuItemId], references: [id])
  cancelledBy User?       @relation("OrderItemCancelledBy", fields: [cancelledById], references: [id])
  therapist   Therapist?  @relation(fields: [therapistId], references: [id], onDelete: SetNull)

  @@index([mobileOrderId])
  @@index([status])
  @@map("mobile_order_item")
}

model QRCode {
  id            String       @id @default(cuid())
  storeId       String
  tableId       String
  type          QRCodeType   @default(STATIC)
  /// ค่าสุ่มที่ฝังใน URL ลูกค้า — ห้ามใช้ tableId ตรง ๆ กันเดา URL
  token         String       @unique
  status        QRCodeStatus @default(ACTIVE)
  invalidatedAt DateTime?
  issuedAt      DateTime     @default(now())
  createdAt     DateTime     @default(now())

  store    Store          @relation(fields: [storeId], references: [id])
  table    Table          @relation(fields: [tableId], references: [id], onDelete: Cascade)
  sessions TableSession[]

  @@index([storeId])
  @@index([tableId])
  @@index([status])
  @@map("qr_code")
}

model Notification {
  id               String             @id @default(cuid())
  storeId          String
  tableSessionId   String
  type             NotificationType
  reason           String?
  status           NotificationStatus @default(PENDING)
  acknowledgedAt   DateTime?
  acknowledgedById String?
  createdAt        DateTime           @default(now())

  store          Store        @relation(fields: [storeId], references: [id])
  session        TableSession @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)
  acknowledgedBy User?        @relation("NotificationAckBy", fields: [acknowledgedById], references: [id])

  @@index([storeId])
  @@index([tableSessionId])
  @@index([status])
  @@map("notification")
}

model LineNotificationLog {
  id             String               @id @default(cuid())
  tableSessionId String
  type           LineNotificationType
  lineUserId     String?
  sentAt         DateTime             @default(now())
  success        Boolean
  errorMessage   String?

  session TableSession @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)

  @@index([tableSessionId])
  @@map("line_notification_log")
}

/// 1 แถวต่อร้าน (Phase 13) — สร้างพร้อม Store ในทรานแซคชันเดียวกันเสมอ ไม่มีร้านที่ไม่มี settings
model StoreSettings {
  id                   String         @id @default(cuid())
  storeId              String         @unique
  storeName            String
  logoUrl              String?
  coverImageUrl        String?
  themeColor           String
  /// ห้ามสลับขณะมี TableSession.status = OPEN อยู่อย่างน้อย 1 โต๊ะ (บังคับที่ updateStoreSettings)
  hasKDS               Boolean        @default(false)
  serviceChargePercent Decimal        @default(0) @db.Decimal(5, 2)
  crmEnabled           Boolean        @default(false)
  /// โหมดเริ่มต้นของจอขายอาหาร /mobile-order/pos (2026-09-17) — ร้านกลับบ้านเป็นหลักไม่ต้องสลับทุกบิล
  posDefaultMode       PosDefaultMode @default(TABLE)
  /// จอครัว (Phase 19) — เสียงเตือนเมื่อมีออร์เดอร์ใหม่บน KDS · เปิดกล่องพิมพ์ทิกเก็ต PDF อัตโนมัติเมื่อออร์เดอร์เข้า
  /// (เส้นทาง ESC/POS ผ่าน KITCHEN_PRINTER_HOST พิมพ์อัตโนมัติอยู่แล้ว ไม่ขึ้นกับค่านี้)
  kitchenAlertSound    Boolean        @default(true)
  kitchenAutoPrint     Boolean        @default(false)
  /// ตัวเลือกร้านนวด (Phase 20) — เปิดแล้ว "เพิ่ม" พนักงานนวด/โปรแกรมนวด/ห้องนวด/จองล่วงหน้า ของเดิมยังอยู่ครบ ใช้ร่วมกันได้
  spaEnabled           Boolean        @default(false)
  /// ช่วงพักระหว่างคิวของพนักงานคนเดียวกัน/ห้องเดียวกัน เป็นนาที (Phase 20b) — 0 = จองต่อกันติดได้
  /// ใช้ทั้งตอนตรวจชนคิวและตอนเสนอช่วงเวลาว่างในฟอร์มจอง
  bookingBufferMinutes Int            @default(10)
  updatedAt            DateTime       @updatedAt
  updatedById          String?

  store     Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  updatedBy User? @relation("StoreSettingsUpdatedBy", fields: [updatedById], references: [id])

  @@map("store_settings")
}

/// โหมดเริ่มต้นของจอขายอาหารฝั่งพนักงาน — TABLE = ขายเข้าโต๊ะ · TAKEAWAY = กลับบ้าน (รับเงินตอนสั่ง)
enum PosDefaultMode {
  TABLE
  TAKEAWAY
}

model Member {
  id           String   @id @default(cuid())
  storeId      String
  /// unique ต่อร้าน (Phase 13) — ลูกค้าคนเดียวเป็นสมาชิกได้หลายร้าน แต้มไม่รวมกัน
  phone        String
  /// denormalized — อัปเดตคู่กับ MemberPointTransaction ใน transaction เดียวกันเสมอ
  pointBalance Int      @default(0)
  lineUserId   String?
  createdAt    DateTime @default(now())

  store             Store                    @relation(fields: [storeId], references: [id])
  pointTransactions MemberPointTransaction[]

  @@unique([storeId, phone])
  @@index([storeId])
  @@map("member")
}

model MemberPointTransaction {
  id        String   @id @default(cuid())
  memberId  String
  saleId    String   @unique
  points    Int
  createdAt DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  sale   Sale   @relation(fields: [saleId], references: [id])

  @@index([memberId])
  @@map("member_point_transaction")
}

// ─────────────── การชำระเงินผ่านธนาคาร (Phase 10 — SCB Open API) ───────────────

enum PaymentIntentStatus {
  PENDING
  PAID
  /// QR หมดอายุก่อนลูกค้าจ่าย — เก็บไว้เพื่อไล่ดูย้อนหลัง ไม่ลบทิ้ง
  EXPIRED
  /// ธนาคารแจ้งกลับมาแล้วแต่ข้อมูลไม่ผ่านการตรวจ (เช่น ยอดไม่ตรง) — ต้องให้พนักงานตรวจเอง
  FAILED
}

/// ตัวกลางแมป "เลขอ้างอิงที่ส่งไปกับ QR" กลับมาเป็นโต๊ะที่จ่ายเงิน
///
/// ทำไมต้องมีตารางนี้ ใส่ tableSessionId ลง ref1 ตรง ๆ ไม่ได้เหรอ:
/// `ref1` ของ SCB รับได้แค่ตัวเลข+ตัวอักษรพิมพ์ใหญ่ ยาวไม่เกิน 20 ตัว แต่ `TableSession.id`
/// เป็น cuid ~25 ตัวและมีตัวพิมพ์เล็ก จึงยัดลงไปตรง ๆ ไม่ได้ ต้องออกโค้ดสั้นแล้วแมปกลับ
///
/// ห้ามจับคู่การชำระเงินด้วย "ยอดเงิน" แทน — สองโต๊ะที่มียอดเท่ากันจะทำให้ปิดบิลผิดโต๊ะ
model PaymentIntent {
  id             String              @id @default(cuid())
  storeId        String
  /// โค้ดที่ส่งเป็น ref1 ให้ธนาคาร — ตัวเดียวที่เดินทางไปกับเงินแล้วกลับมาใน callback
  /// คง unique ทั้งระบบ (ไม่ใช่ต่อร้าน) เพราะ webhook ต้องหาร้านกลับได้จากค่านี้ค่าเดียว
  ref1           String              @unique
  tableSessionId String
  /// ยอด ณ ตอนสร้าง QR — ต้องเทียบกับยอดที่ธนาคารแจ้งกลับมาก่อนปิดบิลเสมอ
  /// ลูกค้าแก้จำนวนเงินในแอปธนาคารได้ ถ้าไม่เทียบจะปิดบิลทั้งที่ได้เงินไม่ครบ
  amount         Decimal             @db.Decimal(12, 2)
  status         PaymentIntentStatus @default(PENDING)
  /// เลขรายการจากธนาคาร — unique กัน callback ยิงซ้ำอีกชั้นนอกเหนือจาก Sale.paymentReference
  transactionId  String?             @unique
  expiresAt      DateTime
  paidAt         DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  store   Store        @relation(fields: [storeId], references: [id])
  session TableSession @relation(fields: [tableSessionId], references: [id])

  @@index([storeId])
  @@index([tableSessionId])
  @@index([status])
  @@map("payment_intent")
}

// ───────────────────── ร้านค้าหลายร้าน (Phase 13 — multi-tenant) ─────────────────────

enum StoreStatus {
  ACTIVE
  /// ผู้ดูแลแพลตฟอร์มระงับ — requireStore() ปฏิเสธทุกคำขอของร้านนี้
  SUSPENDED
}

/// บทบาทระดับร้าน — คนละแกนกับ Role (matrix สิทธิ์ F1–F9)
/// OWNER ได้สิทธิ์เต็มทุก resource อัตโนมัติ และเป็นคนเดียวที่แก้ตั้งค่าร้าน/พนักงานได้
enum StoreRole {
  OWNER
  STAFF
}

/// 1 ร้าน = 1 สาขา — ทุกตารางรากของข้อมูลขายมี storeId ชี้มาที่นี่
/// ห้ามใช้ชื่อ Member (นั่นคือลูกค้าสะสมแต้มของร้าน)
model Store {
  id                String      @id @default(cuid())
  /// ใช้ใน URL/รายงาน/สคริปต์ — ร้านแรกที่ migrate มาจาก v1 คือ "default"
  slug              String      @unique
  name              String
  status            StoreStatus @default(ACTIVE)
  /// ค่า denormalized จากแถว StoreSubscription PAID ล่าสุด (Phase 14b) — อัปเดตในทรานแซคชันเดียวกับการยืนยันเสมอ
  /// planExpiresAt null = ยังไม่มีแพ็กเกจ → ขายไม่ได้ (requireSellingStore) · ร้านเดิมก่อนระบบค่าใช้งาน backfill ถึง 2099
  planTier          PlanTier?
  tableLimit        Int         @default(12)
  planExpiresAt     DateTime?
  /// ระดับเตือนหมดอายุที่ส่งอีเมลไปแล้ว (0/7/3/1) — กันส่งซ้ำ รีเซ็ตเป็น 0 เมื่อต่ออายุ
  expiryNoticeLevel Int         @default(0)
  /// แบรนด์ที่สาขานี้อยู่ใต้ (Phase 14c) — null = ร้านสาขาเดียว ไม่ต้องมี Brand
  brandId           String?
  /// วิธีรับเงินจากลูกค้าของร้านนี้ (Phase 15) — เงินเข้าบัญชีร้านโดยตรงทุกระดับ ไม่มี gateway โอนต่อ
  /// SCB_BILLER ตั้งได้เฉพาะผู้ดูแลแพลตฟอร์ม (15a ยังใช้ credential SCB จาก env ของแพลตฟอร์ม — 15c ย้ายเป็นต่อร้าน)
  paymentMode       PaymentMode @default(PROMPTPAY_DIRECT)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  brand             Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  settings          StoreSettings?
  subscriptions     StoreSubscription[]
  members           StoreMember[]
  roles             Role[]
  products          Product[]
  stockTransactions StockTransaction[]
  categories        Category[]
  sales             Sale[]
  cashierClosings   CashierClosing[]
  tables            Table[]
  tableSessions     TableSession[]
  menuItems         MenuItem[]
  kitchenStations   KitchenStation[]
  therapists        Therapist[]
  therapistShifts   TherapistShift[]
  bookings          Booking[]
  modifierGroups    ModifierGroup[]
  mobileOrders      MobileOrder[]
  qrCodes           QRCode[]
  notifications     Notification[]
  customers         Member[]
  paymentIntents    PaymentIntent[]
  invites           StoreInvite[]
  paymentConfig     StorePaymentConfig?
  assets            StoreAsset[]

  @@index([brandId])
  @@map("store")
}

/// วิธีรับเงินของร้าน (Phase 15) — 3 ระดับ:
///   PROMPTPAY_DIRECT  ก  — QR พร้อมเพย์ของร้านที่สร้างเอง · พนักงานกดยืนยัน (ค่าเริ่มต้นทุกร้าน)
///   PROMPTPAY_SLIP    ก+ — เหมือน ก แต่ลูกค้าแนบสลิปแล้วระบบตรวจ/ปิดบิลเอง (15b — ยังเลือกไม่ได้)
///   SCB_BILLER        ข  — ธนาคารออก QR พก ref1 → callback ปิดบิลอัตโนมัติ (15c ต่อร้าน · 15a = env ของแพลตฟอร์ม)
enum PaymentMode {
  PROMPTPAY_DIRECT
  PROMPTPAY_SLIP
  SCB_BILLER
}

/// บัญชีรับเงินของร้าน (Phase 15a) — แยกจาก StoreSettings เพราะเป็นข้อมูลการเงินที่แก้ได้เฉพาะ OWNER
/// และ 15b/15c จะเติมช่องเทียบผู้รับสลิป / credential SCB (เข้ารหัส) ลงตารางนี้ · promptPayId ย้ายมาจาก StoreSettings
/// (normalize เป็นตัวเลขล้วน) และยังเป็นตัวผูกสิทธิ์ทดลอง 7 วัน (TrialClaim เก็บ hash ของค่านี้)
model StorePaymentConfig {
  id                String    @id @default(cuid())
  storeId           String    @unique
  promptPayId       String?
  /// ชื่อบัญชี/เลขบัญชีไว้เทียบผู้รับตอนตรวจสลิป (15b)
  accountName       String?
  bankAccountNumber String?
  /// SCB Open API ของร้าน (Phase 15c — โหมด ข) · key/secret เข้ารหัส AES-256-GCM ด้วย env PAYMENT_CONFIG_KEY (lib/secret-box.ts)
  /// ห้ามเก็บ/log เป็นข้อความธรรมดา · null ทั้งชุด = ร้านยังไม่ผูก SCB เอง (ร้าน default ใช้ env ของแพลตฟอร์มเป็น fallback)
  scbApiBase        String?
  scbApiKeyEnc      String?
  scbApiSecretEnc   String?
  scbBillerId       String?
  scbRef3Prefix     String?
  /// token ใน URL callback ต่อร้าน /api/payments/webhook/scb/store/<token> — สุ่มตอนบันทึก credential ครั้งแรก
  scbWebhookToken   String?   @unique
  /// ทดสอบการเชื่อมต่อ: ref1 ของ QR 1 บาทที่รอ callback อยู่ (unique ทั้งระบบเหมือน PaymentIntent.ref1) + เวลาเริ่ม
  scbTestRef1       String?   @unique
  scbTestStartedAt  DateTime?
  /// ผ่านการทดสอบ (callback 1 บาทเข้าจริง) เมื่อไหร่ — **null = ยังไม่เปิดปิดบิลอัตโนมัติด้วย credential ของร้าน** (บังคับตาม spec)
  scbVerifiedAt     DateTime?
  updatedAt         DateTime  @updatedAt
  updatedById       String?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_payment_config")
}

/// ผู้ใช้ 1 คนอยู่ได้หลายร้าน — ห้ามเพิ่ม storeId ลงตาราง user ของ Better Auth
/// ต้องมี OWNER อย่างน้อย 1 คนต่อร้านเสมอ (บังคับที่ action ไม่ใช่ DB)
/// ร้านหลายสาขา (Phase 14c) — ชั้นบาง ๆ ครอบ Store หลายตัวเพื่อลดงานซ้ำของเจ้าของ **ไม่ใช่ที่เก็บข้อมูลขาย**
/// ห้ามย้าย Table/MenuItem/Sale ขึ้นมาระดับนี้ · เจ้าของ Brand = OWNER ของทุก Store ใต้ Brand โดยอัตโนมัติ
/// (บังคับที่ lib/store-context.ts แม้ไม่มีแถว StoreMember) · พนักงานยังผูกรายสาขาผ่าน StoreMember เหมือนเดิม
model Brand {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User                @relation("BrandOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  stores  Store[]
  batches SubscriptionBatch[]

  @@index([ownerId])
  @@map("brand")
}

model StoreMember {
  id        String    @id @default(cuid())
  userId    String
  storeId   String
  role      StoreRole @default(STAFF)
  /// matrix สิทธิ์ F1–F9 ของร้านนี้ (§4) — null = ยังไม่กำหนด → เข้าได้เฉพาะ /settings
  /// OWNER ไม่ใช้ค่านี้ (ได้เต็มเสมอ)
  roleId    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user           User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store          Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  permissionRole Role? @relation(fields: [roleId], references: [id])

  @@unique([userId, storeId])
  @@index([storeId])
  @@index([roleId])
  @@map("store_member")
}

/// คำเชิญเข้าร้านทางอีเมล (Phase 14a) — ลิงก์เชิญคือ credential ชั่วคราว จึงเก็บแค่ SHA-256 ของ token
/// ไม่เก็บ token ดิบ (หลุดจากฐานแล้วใช้ไม่ได้) · ใช้ครั้งเดียว: acceptInvite เขียนด้วย
/// updateMany where acceptedAt: null, revokedAt: null (กติกาข้อ 7) กันกดรับพร้อมกันได้ 2 ครั้ง
model StoreInvite {
  id           String    @id @default(cuid())
  storeId      String
  /// เก็บเป็นตัวพิมพ์เล็กเสมอ — ตอนรับต้องตรงกับอีเมลของบัญชีที่ล็อกอินอยู่
  email        String
  role         StoreRole @default(STAFF)
  tokenHash    String    @unique
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?
  revokedAt    DateTime?
  invitedById  String
  createdAt    DateTime  @default(now())

  store      Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  invitedBy  User  @relation("StoreInviteInvitedBy", fields: [invitedById], references: [id])
  acceptedBy User? @relation("StoreInviteAcceptedBy", fields: [acceptedById], references: [id])

  @@index([storeId])
  @@index([email])
  @@map("store_invite")
}

// ───────────────────── ค่าใช้งานแบบต่ออายุ (Phase 14b — Store Subscription) ─────────────────────

/// tier กำหนดเพดานโต๊ะและเรตต่อวัน — เกิน XL (120 โต๊ะ) = ติดต่อเรา ผู้ดูแลใช้ CUSTOM + setTableLimit
enum PlanTier {
  S
  M
  L
  XL
}

enum SubscriptionKind {
  RENEWAL
  /// จ่ายส่วนต่าง tier สำหรับวันที่เหลือ — periodEnd = วันหมดอายุเดิม ไม่ยืดวัน
  UPGRADE
  /// ทดลอง 7 วัน tier S ครั้งเดียวต่อเลขพร้อมเพย์ (TrialClaim)
  TRIAL
  /// ผู้ดูแลแพลตฟอร์มเติมวัน/ชดเชย — และใช้ backfill ร้านที่มีอยู่ก่อนระบบค่าใช้งาน
  CUSTOM
}

enum SubscriptionStatus {
  /// รอผู้ดูแลยืนยันเงินเข้า — ยังไม่มีผลกับ Store.planExpiresAt
  PENDING
  PAID
  /// ยกเลิก (ทั้งคำขอที่ยังไม่จ่าย และการถอยรายการที่ PAID ไปแล้ว — กรณีหลังต้องถอย planExpiresAt/tableLimit ในทรานแซคชันเดียวกัน)
  VOID
}

enum SubscriptionPaymentMethod {
  TRANSFER
  PROMPTPAY
  /// ทดลอง / ชดเชย / backfill ร้านเดิม
  FREE
}

/// แพ็กเกจที่ขาย — **append-only เหมือน StockTransaction**: แก้ราคา/เพดานโต๊ะ = สร้างแถว version ใหม่
/// แล้วตั้ง supersededById + isActive=false ให้แถวเก่า ห้าม UPDATE แถวเดิม → นี่คือ "ประวัติเรต" ที่ตรวจย้อนหลังได้
/// ราคาสุทธิ (price) ตั้งตรง ๆ ไม่คำนวณจาก ratePerDay × days (ปัดเป็นเลขกลมตามตารางใน spec)
model SubscriptionPlan {
  id              String   @id @default(cuid())
  /// เช่น S-D7, M-M3, TRIAL — unique ร่วมกับ version
  code            String
  version         Int      @default(1)
  name            String
  tier            PlanTier
  tableLimit      Int
  durationDays    Int
  ratePerDay      Decimal  @db.Decimal(8, 2)
  discountPercent Decimal  @default(0) @db.Decimal(5, 2)
  price           Decimal  @db.Decimal(10, 2)
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  supersededById  String?  @unique
  createdAt       DateTime @default(now())
  createdById     String?

  supersededBy  SubscriptionPlan?   @relation("PlanSupersession", fields: [supersededById], references: [id])
  supersedes    SubscriptionPlan?   @relation("PlanSupersession")
  subscriptions StoreSubscription[]

  @@unique([code, version])
  @@index([isActive])
  @@map("subscription_plan")
}

/// ledger การต่ออายุของร้าน — append-only · ตัวเลขทุกตัวเป็น snapshot ณ ตอนซื้อ (แก้แพ็กเกจทีหลังไม่กระทบ)
/// Store.planTier/tableLimit/planExpiresAt เป็นค่า denormalized จากแถว PAID ล่าสุด — อัปเดตในทรานแซคชันเดียวกับการยืนยันเสมอ
model StoreSubscription {
  id               String                    @id @default(cuid())
  storeId          String
  /// null เฉพาะ CUSTOM/backfill ที่ไม่ได้อ้างแพ็กเกจใด
  planId           String?
  kind             SubscriptionKind
  tier             PlanTier
  tableLimit       Int
  days             Int
  ratePerDay       Decimal                   @db.Decimal(8, 2)
  discountPercent  Decimal                   @default(0) @db.Decimal(5, 2)
  listPrice        Decimal                   @db.Decimal(10, 2)
  amount           Decimal                   @db.Decimal(10, 2)
  periodStart      DateTime
  periodEnd        DateTime
  status           SubscriptionStatus        @default(PENDING)
  paymentMethod    SubscriptionPaymentMethod
  /// เลขอ้างอิงที่ร้านใส่ในบันทึกโอน (SUB-XXXXXX) — ไว้ให้ผู้ดูแลจับคู่กับรายการในแอปธนาคาร
  requestRef       String                    @unique
  /// เลขอ้างอิงจากธนาคารที่ผู้ดูแลกรอกตอนยืนยัน — unique กันยืนยันซ้ำ/เพิ่มวันซ้ำ
  paymentReference String?                   @unique
  paidAt           DateTime?
  confirmedById    String?
  voidedAt         DateTime?
  voidedById       String?
  /// แถว VOID ที่ถอยรายการ PAID ชี้กลับมาที่รายการเดิม
  reversesId       String?                   @unique
  note             String?
  createdById      String?
  /// ใบจ่ายรวมของแบรนด์ (Phase 14c) — แถวในใบเดียวกันยืนยัน/ยกเลิกพร้อมกันทั้งชุดเท่านั้น
  /// ห้ามยืนยัน/ยกเลิกรายแถวผ่าน confirmSubscription/cancelPendingRequest (ทั้งสองตัวปฏิเสธแถวที่มี batchId)
  batchId          String?
  createdAt        DateTime                  @default(now())

  store    Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan?  @relation(fields: [planId], references: [id])
  reverses StoreSubscription? @relation("SubscriptionReversal", fields: [reversesId], references: [id])
  reversal StoreSubscription? @relation("SubscriptionReversal")
  batch    SubscriptionBatch? @relation(fields: [batchId], references: [id])

  @@index([storeId])
  @@index([status])
  @@index([periodEnd])
  @@index([batchId])
  @@map("store_subscription")
}

/// ใบจ่ายค่าใช้งานรวมหลายสาขา (Phase 14c) — หัวใบถือเลขอ้างอิงธนาคารแทนแถวลูก (paymentReference ของแถวลูกเป็น null)
/// เพราะ StoreSubscription.paymentReference unique ต่อแถว แต่โอนครั้งเดียวครอบหลายสาขา · ยืนยัน = ทรานแซคชันเดียว
/// ทั้งใบ (แถวลูกทุกแถวต้องยัง PENDING ครบ ไม่งั้น rollback ทั้งหมด) · append-only เหมือน StoreSubscription
model SubscriptionBatch {
  id               String             @id @default(cuid())
  brandId          String
  /// เลขอ้างอิงให้ใส่ในบันทึกโอน (BAT-XXXXXX) — คนละชุดกับ SUB-XXXXXX ของแถวลูก
  requestRef       String             @unique
  amount           Decimal            @db.Decimal(10, 2)
  status           SubscriptionStatus @default(PENDING)
  paymentReference String?            @unique
  paidAt           DateTime?
  confirmedById    String?
  voidedAt         DateTime?
  voidedById       String?
  note             String?
  createdById      String?
  createdAt        DateTime           @default(now())

  brand Brand               @relation(fields: [brandId], references: [id], onDelete: Cascade)
  items StoreSubscription[]

  @@index([brandId])
  @@index([status])
  @@map("subscription_batch")
}

/// สิทธิ์ทดลองผูกกับเลขพร้อมเพย์ (SHA-256 ของเลขที่ normalize แล้ว ไม่เก็บเลขดิบ) — 1 เลข = ทดลองได้ครั้งเดียวตลอดกาล
/// **ตั้งใจไม่มี FK/cascade ไป Store** — ร้านถูกลบแถวนี้ต้องอยู่ เลขเดิมโผล่อีก = ไม่ได้ทดลอง ต้องจ่าย
/// และ **ไม่อยู่ใน STORE_SCOPED_MODELS** เพราะต้องค้นข้ามร้านเพื่อกันใช้ซ้ำ
model TrialClaim {
  id              String   @id @default(cuid())
  promptPayIdHash String   @unique
  storeId         String
  claimedAt       DateTime @default(now())

  @@map("trial_claim")
}

/// รูปภาพที่ร้านอัปโหลดเอง (Phase 17a) — เก็บไบต์ลงฐานข้อมูลโดยตั้งใจ
///
/// VPS รันแบบ blue/green คนละคอนเทนเนอร์และไม่มี volume → ไฟล์ที่เขียนลงดิสก์หายทุกรอบ deploy
/// ส่วน object storage ต้องสมัครบริการ + credential ใหม่ · รูปเมนู/โลโก้ถูกย่อในเบราว์เซอร์ให้ ≤ 300KB
/// ก่อนอัปโหลดเสมอ (lib/assets.ts) ฐานจึงโตช้าพอที่จะรับได้ · เสิร์ฟผ่าน /api/assets/[id]
model StoreAsset {
  id           String   @id @default(cuid())
  storeId      String
  /// ชนิดที่ "ตรวจจากไบต์จริง" แล้ว ไม่ใช่ค่าที่เบราว์เซอร์ส่งมา
  contentType  String
  byteSize     Int
  data         Bytes
  uploadedById String?
  createdAt    DateTime @default(now())

  store      Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation("AssetUploadedBy", fields: [uploadedById], references: [id])

  @@index([storeId])
  @@map("store_asset")
}
